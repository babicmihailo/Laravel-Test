# Development image: only PHP and Composer. The code is not copied in,
# compose.yaml mounts the project folder, so every change shows up right away.

FROM php:8.4-cli

RUN apt-get update \
    && apt-get install -y --no-install-recommends git unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

EXPOSE 8000

# Setup runs on every start (the script is in the mounted project folder),
# then the command from compose.yaml runs
ENTRYPOINT ["sh", "docker/dev-entrypoint.sh"]
